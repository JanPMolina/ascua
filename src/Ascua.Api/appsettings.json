{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Ascua": {
    "KeyVaultUri": "",
    "TrustForwardedHeaders": false,
    "Database": {
      "MigrateOnStartup": false
    },
    "Jwt": {
      "Issuer": "ascua",
      "Audience": "ascua-api",
      "AccessTokenLifetime": "00:10:00",
      "RefreshTokenLifetime": "7.00:00:00",
      "AllowEphemeralKey": false
    },
    "Lobby": {
      "RoomTtl": "01:00:00",
      "ActiveMatchTtl": "04:00:00"
    },
    "Matchmaking": {
      "MaxWait": "00:00:30",
      "QueueTimeout": "00:05:00",
      "PollInterval": "00:00:01",
      "Enabled": true
    },
    "RateLimiting": {
      "Auth": { "PermitLimit": 10, "Window": "00:01:00" },
      "User": { "PermitLimit": 60, "Window": "00:01:00" }
    },
    "Realtime": {
      "RoundDuration": "00:00:20",
      "DraftDuration": "00:00:30",
      "ReconnectGrace": "00:01:00",
      "JoinTimeout": "00:02:00",
      "InactivityTimeout": "00:10:00",
      "TicketLifetime": "00:00:30",
      "MaxConnectionsPerUser": 3,
      "HubTokenLimit": 20,
      "HubTokensPerSecond": 5,
      "PublicBaseUrl": "http://localhost:8080",
      "EnableDevEndpoints": false
    },
    "Cors": {
      "AllowedOrigins": [ "http://localhost:8080" ]
    }
  }
}
